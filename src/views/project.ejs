<%- include('partials/header') %>

<main>
    <h1><%= project.title %></h1>
    <p><%= project.description %></p>
    <p>Date: <%= project.date %></p>
    <p>Location: <%= project.location %></p>
    <p>
        Partner Organization:
        <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
    </p>
    <p>
        Categories:
        <% categories.forEach(category => { %>
            <a href="/category/<%= category.category_id %>" class="tag"><%= category.category_name %></a>
        <% }) %>
    </p>
    <a href="/edit-project/<%= project.project_id %>">Edit Project</a>
    <a href="/assign-categories/<%= project.project_id %>">Edit Categories</a>
    
</main>

<%- include('partials/footer') %>